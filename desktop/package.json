{
  "name": "silent-disco-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run build:frontend && node scripts/verify-production-lab-absence.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate_bindings --",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate_bindings -- --check",
    "format": "biome format --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "biome format . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run bindings:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:frontend": "tsc -b && vite build",
    "build:lab": "SILENT_DISCO_LAB_FRONTEND=1 npm run build:frontend",
    "tauri:lab:dev": "tauri dev --features lab-mode",
    "tauri:lab:build": "tauri build --features lab-mode --config src-tauri/tauri.lab.conf.json"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@tauri-apps/api": "2.11.1",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
