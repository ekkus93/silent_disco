exports[`reviewed live host states > approval sent and awaiting delivery confirmation 1`] = `
"
"Live host"
heading2 "Friday night"
button "Refresh"
button "End session"
live-region [live=polite]
  "Approval queued. Waiting for delivery confirmation."
region "Host status" [live=polite]
  heading2 "Host status"
  "Host"
  "Waiting for listeners"
  "OK"
  "Connection"
  "Ready to connect"
  "Playback"
  "stopped"
  "Session service"
  "Available"
  "OK"
region "Live playback and queue controls"
  region "Playback controls"
    heading2 "Playback controls"
    "Requires a selected audio source and an active host session."
    status "Now playing" [live=polite]
      "Golden Hour.flac"
    "0:00 / 3:42"
    progressbar "Playback progress" 0/222000
    button "Play"
    button "Pause" [disabled]
    button "Stop" [disabled]
    checkbox "Local monitor (optional; listeners are unaffected)"
    "Local monitor"
    "(optional; listeners are unaffected)"
  region "Manage queue (3)"
    heading2 "Manage queue (3)"
    "The current song stays in place while it plays."
    button "Add songs"
    list
      listitem
        "1"
        "Golden Hour.flac"
        button "Move Golden Hour.flac up" [disabled]
        button "Move Golden Hour.flac down"
        button "Remove Golden Hour.flac"
      listitem
        "2"
        "Soft Focus.wav"
        button "Move Soft Focus.wav up"
        button "Move Soft Focus.wav down"
        button "Remove Soft Focus.wav"
      listitem
        "3"
        "Afterglow.mp3"
        button "Move Afterglow.mp3 up"
        button "Move Afterglow.mp3 down" [disabled]
        button "Remove Afterglow.mp3"
  "0 listeners"
  button "Create invite"
region "Manual connection details"
  heading2 "Manual connection details"
  "Listeners can enter these details without mDNS."
  definitions
    "Host address"
    "192.168.1.20"
    "mDNS status"
    "Advertising"
    "Control port"
    "47000"
    "Sync port"
    "47001"
    "Audio port"
    "47002"
    "Session ID"
    "session-friday"
    "Protocol version"
    "2"
    "Invite code"
    "not required"
    "Expiration"
    "No expiration policy"
  button "Copy host address"
  button "Copy session ID"
  button "Copy connection payload"
region "QR invitation"
  heading2 "QR invitation"
  "A signed, time-limited invitation a phone can scan to join directly -- a convenience alongside the manual details above, not a replacement for them."
  button "Create QR invitation"
  "No invitation created yet. This does not affect manual connections above."
region "Pending join requests"
  heading2 "Pending join requests"
  list
    listitem [busy=true]
      "Jo's Pixel"
      "Request request-jo"
      "Device device-jo"
      "Age: 2 s"
      "Trust: session_only"
      "Invite: valid"
      group [disabled]
        checkbox "Remember this device"
        button "Approve"
        button "Reject"
      "Waiting for approval delivery confirmation…"
region "Connected listeners"
  heading2 "Connected listeners"
  "No listeners have joined yet."
"
`;

