exports[`reviewed host setup states > Access step with invite code and field validation 1`] = `
"
region "Create a silent disco"
  "Host setup"
  heading2 "Create a silent disco"
  "Choose a playlist, set who can join, then review the session before you start."
  navigation "Host setup steps"
    "1. Music"
    "2. Access" [current=step]
    "3. Ready"
  form
    combobox "Listener approval" = "Require an invite code"
    textbox "Invite code" = ""
    "Enter an invite code."
    checkbox "Remember approved devices"
    "Remember approved devices"
    "Approved devices can join future sessions without asking again."
    button "Back to music"
    button "Review session"
    button "Advanced tuning"
  complementary "Host setup summary"
    heading3 "Playlist (3)"
    list
      listitem
        "1. Golden Hour.flac"
        button "Move Golden Hour.flac up" [disabled]
        button "Move Golden Hour.flac down"
        button "Remove Golden Hour.flac"
      listitem
        "2. Soft Focus.wav"
        button "Move Soft Focus.wav up"
        button "Move Soft Focus.wav down"
        button "Remove Soft Focus.wav"
      listitem
        "3. Afterglow.mp3"
        button "Move Afterglow.mp3 up"
        button "Move Afterglow.mp3 down" [disabled]
        button "Remove Afterglow.mp3"
    region "Network interface"
      heading3 "Network interface"
      "Configured in Settings. An eligible IPv4 address must be selected before hosting."
      button "Configure in Settings"
      "Ready to bind enp1s0 at 192.168.1.20."
    heading3 "Local monitor"
    checkbox "Enable local monitor after the audio-output adapter is connected" [disabled]
"
`;

