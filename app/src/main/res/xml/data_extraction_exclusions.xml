<?xml version="1.0" encoding="utf-8"?>
<!-- Deny cloud restore AND device-to-device migration of identity-bound data.
     Root excludes every private app file, including SQLite/prefs/cached audio.
     The allowBackup=false manifest flag is an additional independent guard. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
